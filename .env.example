# ─── Copy this file to .env and fill in your values ──────────────────────────
# NEVER commit .env to GitHub

# Admin login credentials
ADMIN_ID=admin
ADMIN_PASSWORD=password

# Server port (Render sets this automatically)
PORT=3000

# Your Render app URL — set AFTER first deploy (no trailing slash)
# Example: https://ami-qr-system.onrender.com
BASE_URL=https://ami-qr-system.onrender.com
# Render persistent disk mount path — must match Render dashboard setting
RENDER_DISK_MOUNT=/data
